{
  "dialogues_A0": [
    {
      "id": "dlg_ch1_james_welcome",
      "npcId": "james_york",
      "cefr": "A0",
      "line": "Hello! Welcome to COSY Town. I am James York.",
      "gestures": ["wave", "point_hq"],
      "highlights": ["welcome_sign"],
      "speechRate": 0.65
    },
    {
      "id": "dlg_ch1_reception_intro",
      "npcId": "receptionist",
      "cefr": "A0",
      "line": "Hello! What is your name? I am the receptionist.",
      "gestures": ["wave", "offer_key"],
      "highlights": ["reception_desk", "apartment_key"],
      "speechRate": 0.65
    },
    {
      "id": "dlg_ch2_james_home",
      "npcId": "james_york",
      "cefr": "A0",
      "line": "There is a sofa in the living room and a bed in the bedroom.",
      "gestures": ["point_furniture", "point_room"],
      "highlights": ["sofa", "bed", "desk"],
      "speechRate": 0.65
    },
    {
      "id": "dlg_ch2_where_is",
      "npcId": "james_york",
      "cefr": "A0",
      "line": "Where is the key? This is the desk, and that is the bed.",
      "gestures": ["search", "point"],
      "highlights": ["desk", "bed", "key"],
      "speechRate": 0.65
    },
    {
      "id": "dlg_ch3_daily_routine",
      "npcId": "james_york",
      "cefr": "A1",
      "line": "I wake up at seven o'clock in the morning. I always brush my teeth and eat breakfast.",
      "gestures": ["stretch", "eat_breakfast"],
      "highlights": ["alarm_clock", "kettle"],
      "speechRate": 0.75
    },
    {
      "id": "dlg_ch3_ask_time",
      "npcId": "james_york",
      "cefr": "A1",
      "line": "What time is it? It is eight o'clock in the morning. I usually take the bus to work.",
      "gestures": ["check_watch", "point_bus"],
      "highlights": ["street_clock", "bus_stop_sign"],
      "speechRate": 0.75
    },
    {
      "id": "dlg_door_A0",
      "npcId": "james_york",
      "cefr": "A0",
      "line": "Open the door.",
      "gestures": ["point_door"],
      "highlights": ["door_lock"],
      "speechRate": 0.65
    }
  ],
  "dialogues_A1": [
    {
      "id": "dlg_bakery_A1",
      "npcId": "ella_baker",
      "cefr": "A1",
      "line": "Would you like fresh bread?",
      "gestures": ["offer_bread"],
      "speechRate": 0.8
    },
    {
      "id": "dlg_ch4_ask_directions",
      "npcId": "james_york",
      "cefr": "A1",
      "line": "Excuse me! Where is the post office? How do I get to the pharmacy?",
      "gestures": ["search", "point_map"],
      "highlights": ["post_office_building", "pharmacy_building"],
      "speechRate": 0.75
    },
    {
      "id": "dlg_ch4_give_directions",
      "npcId": "james_york",
      "cefr": "A1",
      "line": "Go straight, turn left at the crosswalk, and turn right. The pharmacy is next to the bakery and behind the park.",
      "gestures": ["point_directions", "turn_left", "turn_right"],
      "highlights": ["pharmacy_building", "bakery_building", "park"],
      "speechRate": 0.75
    },
    {
      "id": "dlg_ch4_help_npc",
      "npcId": "postmaster_sam",
      "cefr": "A1",
      "line": "Thank you for helping me find the post office! You unlocked the full city map of the neighbourhood!",
      "gestures": ["thank", "show_map"],
      "highlights": ["post_office_building"],
      "speechRate": 0.75
    }
  ]
}
